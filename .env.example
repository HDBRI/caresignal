# CareSignal environment variables — placeholders only. Copy to .env and fill in.
# The app looks for .env in this folder first, then in the parent folder.

# Required for AI analysis (course key). Without it the app still runs; AI shows "unavailable".
PORTKEY_API_KEY=your-portkey-api-key-here

# Hosted mode only (Supabase Auth + Postgres). Leave ALL blank to use the local database fallback.
# Server-only. Supabase "Transaction pooler" connection string (port 6543).
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Hosted mode: public URL of the app (used in password-reset email links)
NEXT_PUBLIC_SITE_URL=

# Optional: shared PUBLIC demo password (default CareSignal-Demo-2026). Not a secret.
DEMO_PASSWORD=

# Optional AI analysis caps (observation entry is never capped). Defaults: 25 per user, 500 global, per UTC day.
AI_DAILY_LIMIT_PER_USER=25
AI_DAILY_LIMIT_GLOBAL=500

# Optional: custom folder for the local database (default: data/pgdata)
CARESIGNAL_PGLITE_DIR=
